# Kasa — ortam degiskeni sablonu
#
# Bu dosya git'e GIRER. Gercek degerleri iceren `.env.simulation` ve `.env.live` GIRMEZ.
# Kurulum:  cp .env.example .env.simulation   sonra  pnpm gen:accounts
#
# Adres ve gizli anahtarlar BU DOSYADA BOS birakilir ve elle doldurulmaz:
# `scripts/gen-accounts.ts` uretir ve yazar (MASTER PROMPT A.3 — uydurma yasagi).

# ---------------------------------------------------------------------------
# Mod anahtari
# ---------------------------------------------------------------------------
# simulation = mock anchor + mock DeFindex + kendi deploy ettigimiz test token'i
# live       = gercek anchor TOML'i + @defindex/sdk
KASA_MODE=simulation

# ---------------------------------------------------------------------------
# Hesaplar — pnpm gen:accounts tarafindan uretilir, friendbot ile fonlanir
# ---------------------------------------------------------------------------
ADMIN_SECRET=
ADMIN_PUBLIC=
MEMBER_A_SECRET=
MEMBER_A_PUBLIC=
MEMBER_B_SECRET=
MEMBER_B_PUBLIC=
MEMBER_C_SECRET=
MEMBER_C_PUBLIC=

# Mock USDC ihracci hesabi (yalnizca simulasyon). Gercek Circle testnet USDC issuer'i
# EZBERDEN YAZILMAZ; canliya gecerken faucet.circle.com'dan dogrulanarak alinir.
MOCK_USDC_ISSUER_SECRET=
MOCK_USDC_ISSUER_PUBLIC=

# ---------------------------------------------------------------------------
# Kontratlar — scripts/deploy-mock-token.sh ve scripts/deploy.sh tarafindan yazilir
# ---------------------------------------------------------------------------
# Simulasyondaki sahte dfToken (SEP-41 arayuzlu Soroban token ornek kontrati)
MOCK_DFTOKEN_CONTRACT_ID=
# Kasa kontrati
SHARED_VAULT_CONTRACT_ID=

# ---------------------------------------------------------------------------
# Anchor
# ---------------------------------------------------------------------------
# Simulasyonda mock anchor; canlida Workshop #3'te verilecek gercek domain.
# Kodda hardcoded domain YOKTUR (MASTER PROMPT Bolum 9).
ANCHOR_HOME_DOMAIN=localhost:8788
# Mock anchor'in SEP-10 challenge'larini imzaladigi anahtar (TOML'deki SIGNING_KEY).
MOCK_ANCHOR_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# DeFindex
# ---------------------------------------------------------------------------
DEFINDEX_API_KEY=simulation-not-used

# ===========================================================================
# YALNIZCA CANLI MOD (KASA_MODE=live) — etkinlik gunu doldurulur, A.5 listesi
# Canli modda bunlardan biri bossa uygulama ACILISTA PATLAR; varsayilana dusmez.
# ===========================================================================
# ANCHOR_FIAT_CODE=
# ANCHOR_ASSET_CODE=
# ANCHOR_ASSET_ISSUER=
# DEFINDEX_VAULT_ID=
# SHARE_TOKEN_ID=
